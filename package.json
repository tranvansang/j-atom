{
	"name": "j-atom",
	"version": "0.2.0-alpha.2",
	"type": "module",
	"scripts": {
		"prepublishOnly": "npx tsc",
		"test": "vitest run useAtom.test.ts && node --test makeAtom.test.ts",
		"test:coverage": "vitest run --coverage useAtom.test.ts && node --test --experimental-test-coverage makeAtom.test.ts"
	},
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		},
		"./react": {
			"types": "./react.d.ts",
			"default": "./react.js"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tranvansang/j-atom.git"
	},
	"files": [
		"index.js",
		"index.d.ts",
		"react.js",
		"react.d.ts"
	],
	"devDependencies": {
		"@testing-library/react": "^16.3.0",
		"@types/node": "^25.3.5",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitest/coverage-v8": "^4.0.14",
		"jsdom": "^27.2.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.14"
	}
}
