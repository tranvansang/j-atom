{
	"name": "j-atom",
	"version": "0.0.1",
	"scripts": {
		"prepublishOnly": "npx tsc index.ts react.ts --lib esnext,dom --target esnext --declaration --skipLibCheck --moduleResolution bundler --module esnext",
		"test": "vitest run *.test.ts",
		"test:coverage": "vitest run --coverage *.test.ts"
	},
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js"
		},
		"./react": {
			"types": "./react.d.ts",
			"import": "./react.js"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tranvansang/j-atom.git"
	},
	"files": [
		"index.js",
		"index.d.ts",
		"react.js",
		"react.d.ts"
	],
	"devDependencies": {
		"@testing-library/react": "^16.3.0",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitest/coverage-v8": "^4.0.14",
		"jsdom": "^27.2.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.14"
	}
}
